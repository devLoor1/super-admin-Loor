# Nest Control Plane (backend-super-admin-Loor)
VITE_API_BASE_URL=http://localhost:3334/api
# Name-only PATCH (and legacy POST create). Keep false until authorized.
# UI CREATE is Implantar (provisioning); this flag also gates name edit submit.
VITE_WHITELABEL_WRITES_ENABLED=false
VITE_SHOWCASE_ENABLED=false
# Activate / deactivate (soft). No physical delete. Keep false until authorized.
VITE_WHITELABEL_LIFECYCLE_ENABLED=false
# Stage B transport only. Sidebar enforcement is independent and remains absent.
VITE_MENU_VISIBILITY_WRITES_ENABLED=false

# URL mode for Whitelabel provisioning comes from Nest:
# GET /whitelabel-provisionings/config → PROVISIONING_FRONTEND_URL_MODE
# Do not add VITE_PROVISIONING_URL_MODE (avoids Nest/FE divergence).
